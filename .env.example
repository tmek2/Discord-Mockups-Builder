# Sign-in. Without these the editor still runs, saves locally and exports —
# only the account and the cloud backup are switched off.
AUTH_SECRET=
AUTH_URL=https://mockups.gatorsys.xyz
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Cloud backup and short share links. Without MONGODB_URI the editor still
# saves locally, keeps its own backups, and shares by fragment link.
MONGODB_URI=
MONGODB_DB=gator-mockups
